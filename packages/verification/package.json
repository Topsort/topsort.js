{
  "name": "@topsort/verification",
  "version": "0.1.0",
  "description": "Browser runtime for third-party verification of Topsort-served ads",
  "private": true,
  "type": "module",
  "author": "Topsort",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Topsort/topsort.js.git",
    "directory": "packages/verification"
  },
  "bugs": {
    "url": "https://github.com/Topsort/topsort.js/issues"
  },
  "homepage": "https://github.com/Topsort/topsort.js/tree/main/packages/verification#readme",
  "keywords": [
    "ads",
    "advertising",
    "ias",
    "topsort",
    "verification",
    "viewability"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/react.d.ts",
    "dist/react.js",
    "package.json"
  ],
  "scripts": {
    "build": "bunup",
    "build:browser-fixture": "bun build ./e2e/fixture.tsx --outdir ./e2e/dist --format esm --target browser",
    "serve:browser-fixture": "bun run ./e2e/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:browser": "bun run build && bun run build:browser-fixture && playwright test --config playwright.config.ts",
    "test:package": "bun run build && bun run ./scripts/verify-package.ts"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.7",
    "@types/react-test-renderer": "18.3.1",
    "linkedom": "0.18.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
